{
  "name": "clam",
  "version": "1.0.0",
  "private": true,
  "description": "Clam \u2014 Semantic Permission Layer & Zero-Retention MCP Firewall for Email",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @clam/server --filter @clam/web dev",
    "dev:server": "pnpm --filter @clam/server dev",
    "dev:web": "pnpm --filter @clam/web dev",
    "build": "pnpm --filter @clam/shared build && pnpm --filter @clam/agent build && pnpm --filter @clam/server build && pnpm --filter @clam/web build",
    "typecheck": "pnpm --filter @clam/shared typecheck && pnpm --filter @clam/agent typecheck && pnpm --filter @clam/server typecheck && pnpm --filter @clam/web typecheck",
    "agent:run": "tsx scripts/run-demo.ts",
    "kill": "tsx scripts/kill.ts",
    "resume": "tsx scripts/kill.ts --resume",
    "verify:zero-retention": "tsx scripts/verify-zero-retention.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "agent": "tsx scripts/inbox-agent.ts",
    "clam-mcp": "tsx apps/server/src/mcp/stdio.ts",
    "run-trap-pack": "tsx scripts/inbox-agent.ts run-official-trap-pack",
    "test:adversarial": "tsx scripts/inbox-agent.ts test-adversarial",
    "run-official-trap-pack": "tsx scripts/inbox-agent.ts run-official-trap-pack",
    "workspace:smoke": "tsx scripts/workspace-live-smoke.ts"
  },
  "devDependencies": {
    "pnpm": "^10.10.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
