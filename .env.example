# Clam Server & Web Configuration
PORT=4000
WEB_PORT=3000
CLAM_PUBLIC_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# SQLite path for policies, the encrypted vault, sandbox fixtures, and structured run receipts
DATABASE_PATH=./data/clam.db

# Local vault for settings and approval-channel secrets
# Leave empty in local dev to auto-generate a local .clam.key file (mode 0600)
CLAM_ENCRYPTION_KEY=

# Keep the legacy sandbox fixtures enabled. Google accounts are selected in Connections.
CLAM_MAIL_MODE=sandbox

# Optional Google Sign-In, Gmail, and Calendar. Leave these empty for the sandbox.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# Generate each key independently with openssl rand -hex 32.
CLAM_TOKEN_ENCRYPTION_KEY=
CLAM_SESSION_SECRET=
CLAM_MAIL_ATTACHMENTS_DIR=./workspace/mail-attachments
# Optional JSON map from a verification sender domain to exact HTTPS link hosts.
CLAM_VERIFICATION_REDIRECTS=

# Primary LLM agent. Set llm/offline-smoke explicitly, or leave blank for key/endpoint detection.
CLAM_AGENT_MODE=
# Supported: gemini | openai | anthropic | groq | ollama
CLAM_LLM_PROVIDER=
CLAM_LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=
CLAM_CLASSIFIER_TIMEOUT_MS=8000

# Optional HITL Approval Channel Integrations
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_NUMBER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Default approval TTL in seconds (15 minutes = 900)
CLAM_APPROVAL_TTL_SECONDS=900

# Autonomous Agent Deliverables & JSONL Traces
CLAM_ARTIFACTS_DIR=./artifacts
CLAM_TRACES_DIR=./traces

# Auto-Trip Circuit Breaker Thresholds
CLAM_CB_VIOLATION_THRESHOLD=3
CLAM_CB_WINDOW_SECONDS=30
CLAM_CB_MAX_CALLS_PER_MIN=25
CLAM_CB_TRIP_CRITICAL_INJECTION=true

# Zero-key smoke mode costs $0. Compose selects it explicitly.
CLAM_INBOX_LIVE=false
CLAM_BIND_HOST=127.0.0.1
CLAM_WEB_ORIGIN=http://localhost:3000
CLAM_INBOX_API_ORIGIN=http://127.0.0.1:4000
CLAM_KILLSWITCH_FILE=.killswitch
CLAM_GOOGLE_CALENDAR_ID=primary
# Optional for trusted local CLI use. Set CLAM_INBOX_ID to select a connected account.
CLAM_OPERATOR_TOKEN=
CLAM_INBOX_ID=
# Leave pricing blank for the per-model defaults or an unpriced provider.
CLAM_MODEL_INPUT_USD_PER_M=
CLAM_MODEL_OUTPUT_USD_PER_M=
CLAM_AGENT_TIMEOUT_MS=
CLAM_KEY_FILE=.clam.key
