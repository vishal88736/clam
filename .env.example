# Clam Server & Web Configuration
PORT=4000
WEB_PORT=3000
CLAM_PUBLIC_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# SQLite path for policies, the encrypted vault, sandbox fixtures, and structured run receipts
DATABASE_PATH=./data/clam.db

# 32-byte hex or passphrase for AES-256-GCM encryption of OAuth tokens & vault secrets
# Leave empty in local dev to auto-generate a local .clam.key file (mode 0600)
CLAM_ENCRYPTION_KEY=

# Mail Mode: sandbox (default, zero setup) | gmail
CLAM_MAIL_MODE=sandbox

# Optional Google OAuth2 for Real Gmail Connector
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/gmail/callback

# Optional Semantic Classifier LLM (defaults to local deterministic heuristic engine)
# Supported: local_heuristic | openai | anthropic | gemini | ollama
CLAM_LLM_PROVIDER=local_heuristic
CLAM_LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
CLAM_CLASSIFIER_TIMEOUT_MS=8000

# Optional HITL Approval Channel Integrations
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_NUMBER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Default approval TTL in seconds (15 minutes = 900)
CLAM_APPROVAL_TTL_SECONDS=900

# Autonomous Agent Deliverables & JSONL Traces
CLAM_ARTIFACTS_DIR=./artifacts
CLAM_TRACES_DIR=./traces

# Auto-Trip Circuit Breaker Thresholds
CLAM_CB_VIOLATION_THRESHOLD=3
CLAM_CB_WINDOW_SECONDS=30
CLAM_CB_MAX_CALLS_PER_MIN=25
CLAM_CB_TRIP_CRITICAL_INJECTION=true

# Inbox automation uses the local deterministic replay/heuristic by default ($0 per sandbox run).
CLAM_INBOX_LIVE=false
CLAM_BIND_HOST=127.0.0.1
CLAM_WEB_ORIGIN=http://localhost:3000
CLAM_INBOX_API_ORIGIN=http://127.0.0.1:4000
CLAM_KILLSWITCH_FILE=.killswitch
CLAM_GOOGLE_CALENDAR_ID=primary
# Required for live Inbox REST/CLI. Use a randomly generated secret; never prefix with NEXT_PUBLIC_.
CLAM_OPERATOR_TOKEN=
# Optional confidence-only model review for live runs; configure CLAM_LLM_MODEL and the selected provider key.
CLAM_INBOX_MODEL_REVIEW=false
CLAM_MODEL_INPUT_USD_PER_M=0
CLAM_MODEL_OUTPUT_USD_PER_M=0
CLAM_KEY_FILE=.clam.key
