# Siftvane Server & Web Configuration
PORT=4000
WEB_PORT=3000
SIFTVANE_PUBLIC_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# SQLite path for policies, the encrypted vault, sandbox fixtures, and structured run receipts
DATABASE_PATH=./data/siftvane.db

# Local vault for settings and approval-channel secrets
# Leave empty in local dev to auto-generate a local .siftvane.key file (mode 0600)
SIFTVANE_ENCRYPTION_KEY=

# Keep the legacy sandbox fixtures enabled. Google accounts are selected in Connections.
SIFTVANE_MAIL_MODE=sandbox

# Optional Google Sign-In, Gmail, and Calendar. Leave these empty for the sandbox.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# Generate each key independently with openssl rand -hex 32.
SIFTVANE_TOKEN_ENCRYPTION_KEY=
SIFTVANE_SESSION_SECRET=
SIFTVANE_MAIL_ATTACHMENTS_DIR=./workspace/mail-attachments
# Optional JSON map from a verification sender domain to exact HTTPS link hosts.
SIFTVANE_VERIFICATION_REDIRECTS=

# Primary LLM agent. Set llm/offline-smoke explicitly, or leave blank for key/endpoint detection.
SIFTVANE_AGENT_MODE=
# Supported: gemini | openai | anthropic | groq | ollama
SIFTVANE_LLM_PROVIDER=
SIFTVANE_LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=
SIFTVANE_CLASSIFIER_TIMEOUT_MS=8000

# Optional HITL Approval Channel Integrations
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_NUMBER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Default approval TTL in seconds (15 minutes = 900)
SIFTVANE_APPROVAL_TTL_SECONDS=900

# Autonomous Agent Deliverables & JSONL Traces
SIFTVANE_ARTIFACTS_DIR=./artifacts
SIFTVANE_TRACES_DIR=./traces

# Auto-Trip Circuit Breaker Thresholds
SIFTVANE_CB_VIOLATION_THRESHOLD=3
SIFTVANE_CB_WINDOW_SECONDS=30
SIFTVANE_CB_MAX_CALLS_PER_MIN=25
SIFTVANE_CB_TRIP_CRITICAL_INJECTION=true

# Zero-key smoke mode costs $0. Compose selects it explicitly.
SIFTVANE_INBOX_LIVE=false
SIFTVANE_BIND_HOST=127.0.0.1
SIFTVANE_WEB_ORIGIN=http://localhost:3000
SIFTVANE_INBOX_API_ORIGIN=http://127.0.0.1:4000
SIFTVANE_KILLSWITCH_FILE=.killswitch
SIFTVANE_GOOGLE_CALENDAR_ID=primary
# Optional for trusted local CLI use. Set SIFTVANE_INBOX_ID to select a connected account.
SIFTVANE_OPERATOR_TOKEN=
SIFTVANE_INBOX_ID=
# Leave pricing blank for the per-model defaults or an unpriced provider.
SIFTVANE_MODEL_INPUT_USD_PER_M=
SIFTVANE_MODEL_OUTPUT_USD_PER_M=
SIFTVANE_AGENT_TIMEOUT_MS=
SIFTVANE_KEY_FILE=.siftvane.key
# Set this only when reusing an existing Docker Compose sandbox volume.
# SIFTVANE_SANDBOX_VOLUME=
