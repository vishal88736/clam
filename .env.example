# Clam Server & Web Configuration
PORT=4000
WEB_PORT=3000
CLAM_PUBLIC_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# SQLite database path (metadata, policy IR, encrypted vault, zero-content audit logs ONLY)
DATABASE_PATH=./data/clam.db

# 32-byte hex or passphrase for AES-256-GCM encryption of OAuth tokens & vault secrets
# Leave empty in local dev to auto-generate a local .clam.key file (mode 0600)
CLAM_ENCRYPTION_KEY=

# Mail Mode: sandbox (default, zero setup) | gmail
CLAM_MAIL_MODE=sandbox

# Optional Google OAuth2 for Real Gmail Connector
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/gmail/callback

# Optional Semantic Classifier LLM (defaults to local deterministic heuristic engine)
# Supported: local_heuristic | openai | anthropic | gemini | ollama
CLAM_LLM_PROVIDER=local_heuristic
CLAM_LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
CLAM_CLASSIFIER_TIMEOUT_MS=8000

# Optional HITL Approval Channel Integrations
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_NUMBER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Default approval TTL in seconds (15 minutes = 900)
CLAM_APPROVAL_TTL_SECONDS=900
